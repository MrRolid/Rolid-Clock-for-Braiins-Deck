#!/bin/sh
# ROLID_AUDIO_SERVICE_V1
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
root=/mnt/data/rolid-audio
reply() {
    printf 'Status: %s\r\nContent-Type: text/plain\r\nCache-Control: no-store\r\n\r\n%s\n' "$1" "$2"
    exit 0
}
case "${REMOTE_ADDR:-}" in 127.0.0.1|::1) :;; *) reply '403 Forbidden' 'local only';; esac
if [ "${REQUEST_METHOD:-}" = GET ] && [ "${QUERY_STRING:-}" = status ]; then
    [ -x /usr/bin/madplay ] && [ -r "$root/sounds/gong.mp3" ] && [ -r "$root/sounds/alarm.mp3" ] || reply '503 Service Unavailable' 'missing player or MP3'
    reply '200 OK' 'rolid-audio-v1 ready'
fi
[ "${REQUEST_METHOD:-}" = POST ] || reply '405 Method Not Allowed' 'POST required'
[ "${HTTP_AUTHORIZATION:-}" = Rolid-local-v1 ] || reply '403 Forbidden' 'header required'
case "${QUERY_STRING:-}" in
    action=stop) action=stop; vol=0;;
    action=gong\&volume=*) action=gong; vol=${QUERY_STRING#action=gong&volume=};;
    action=alarm\&volume=*) action=alarm; vol=${QUERY_STRING#action=alarm&volume=};;
    *) reply '400 Bad Request' 'invalid action';;
esac
case "$vol" in [0-9]|[1-9][0-9]|100) :;; *) reply '400 Bad Request' 'volume must be 0..100';; esac
mkdir -p /tmp/rolid-audio
chmod 700 /tmp/rolid-audio
mkdir /tmp/rolid-audio/request.lock 2>/dev/null || reply '409 Conflict' 'busy'
trap 'rmdir /tmp/rolid-audio/request.lock 2>/dev/null' EXIT
trap 'exit 1' HUP INT TERM
/bin/sh "$root/stop.sh"
[ "$action" = stop ] && reply '200 OK' 'stopped'
[ "$vol" -eq 0 ] && reply '200 OK' 'muted'
[ -r "$root/sounds/$action.mp3" ] || reply '503 Service Unavailable' 'missing MP3'
# Same -40..0 dB range as Deck; zero is explicit mute.
db=$(( (vol * 40 + 50) / 100 - 40 ))
/usr/bin/madplay -q -A "$db" "$root/sounds/$action.mp3" </dev/null >/tmp/rolid-audio/player.log 2>&1 &
pid=$!
printf '%s\n' "$pid" > /tmp/rolid-audio/player.pid
kill -0 "$pid" 2>/dev/null || reply '503 Service Unavailable' 'player failed'
reply '200 OK' 'accepted'
