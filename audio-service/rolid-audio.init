#!/bin/sh /etc/rc.common
# ROLID_AUDIO_SERVICE_V1
START=95
STOP=10
USE_PROCD=1
start_service() {
    mkdir -p /tmp/rolid-audio
    chmod 700 /tmp/rolid-audio
    rmdir /tmp/rolid-audio/request.lock 2>/dev/null || :
    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -p 127.0.0.1:18764 -h /mnt/data/rolid-audio/www -c /mnt/data/rolid-audio/httpd.conf -x /cgi-bin -t 5 -T 5 -D -S
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /bin/sh /mnt/data/rolid-audio/stop.sh
}
